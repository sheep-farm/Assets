using Gtk 4.0;
using Adw 1;

template $AssetsWindow : Adw.ApplicationWindow {
  width-request: 1200;
  height-request: 700;

  content: Adw.ToastOverlay toast_overlay {
    child: Adw.OverlaySplitView split_view {
      sidebar-position: start;
      show-sidebar: bind sidebar_toggle.active;
      min-sidebar-width: 250;
      max-sidebar-width: 350;
      sidebar-width-fraction: 0.25;

      sidebar: Box toolbar_box {
        orientation: vertical;

        SearchEntry search_entry {
          placeholder-text: "Search nodes...";
          margin-top: 6;
          margin-bottom: 6;
          margin-start: 6;
          margin-end: 6;
        }

        ScrolledWindow {
          vexpand: true;
          hscrollbar-policy: never;
          margin-start: 6;
          margin-end: 6;

          ListBox node_list {
            selection-mode: none;
            styles ["navigation-sidebar"]
          }
        }

        Separator {
          margin-top: 6;
        }

        Box toolbar_controls {
          orientation: horizontal;
          spacing: 6;
          margin-top: 6;
          margin-bottom: 6;
          margin-start: 6;
          margin-end: 6;
          homogeneous: true;

          ToggleButton favorites_toggle {
            icon-name: "starred-symbolic";
            tooltip-text: "Show Favorites";
          }

          Button import_button {
            icon-name: "document-open-symbolic";
            tooltip-text: "Import Library";
          }

          Button export_button {
            icon-name: "document-save-symbolic";
            tooltip-text: "Export Library";
          }
        }
      };

      content: Adw.ToolbarView {
        [top]
        Adw.HeaderBar {
          [start]
          ToggleButton sidebar_toggle {
            icon-name: "sidebar-show-symbolic";
            tooltip-text: "Toggle Sidebar";
            active: true;
          }

          title-widget: Label {
            label: "Assets";
            styles ["title"]
          };

          [end]
          MenuButton {
            icon-name: "open-menu-symbolic";
            menu-model: primary_menu;
          }

          // [end]
          // ToggleButton result_toggle {
          //   icon-name: "view-top-pane-symbolic";
          //   tooltip-text: "Toggle Result Area";
          //   active: true;
          // }

          [end]
          Button run_button {
            icon-name: "media-playback-start-symbolic";
            tooltip-text: "Run Graph";
            // styles ["suggested-action"]
          }
        }

        content: Box {
          orientation: vertical;
          vexpand: true;

          Box canvas_box {
            orientation: vertical;
            vexpand: true;
          }

          // Box result_box {
          //   orientation: vertical;
          //   vexpand: true;
          // }
        };
      };
    };
  };
}

menu primary_menu {
  section {
    item {
      label: _("New");
      action: "win.new";
    }
    item {
      label: _("Open");
      action: "win.open";
    }
    item {
      label: _("Save");
      action: "win.save";
    }
    item {
      label: _("Save As…");
      action: "win.save-as";
    }
    item {
      label: _("Close Tab");
      action: "win.close-tab";
    }
  }

  section {
    item {
      label: _("Preferences");
      action: "app.preferences";
    }
    item {
      label: _("About Assets");
      action: "app.about";
    }
  }
}

